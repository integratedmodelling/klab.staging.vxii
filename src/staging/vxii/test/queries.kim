private namespace staging.vxii.test.queries version 1.0;

/** Tentative read-only query inputs. See docs/query-acceptance.md for prerequisites and limits. */
define observation rectangle as {
    semantics: {{earth:Region}}
    space: {
        shape: "EPSG:3857 POLYGON ((200000 6000000,200000 6000400,200500 6000400,200500 6000000,200000 6000000))"
        grid: "100 m"
    }
};

