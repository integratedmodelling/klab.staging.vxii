private namespace staging.vxii.test.classification
    version 1.0;

@test
define observation testregion as {
	semantics: geography:Tanzania earth:Region
	space: {
		shape: "EPSG:4326 POLYGON((33.796 -7.086, 35.946 -7.086, 35.946 -9.41, 33.796 -9.41, 33.796 -7.086))"
		grid: 1.km
	}
	time: {
		year: 2014
		step: 1.day
	}
};

model geography:Tanzania earth:Region
    observing 
		earth:PhysicalEnvironment of each earth:Region;

model earth:PhysicalEnvironment of each earth:Region
	using klab.generators.random.categories();

model klab:random:objects:polygons 
   as each earth:Region;