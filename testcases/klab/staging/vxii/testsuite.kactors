// TODO a test case named <projectname>.testsuite is the default test case for a project
testcase klab.staging.vxii.testsuite
    "Exercises the self-contained observations in the klab.staging.vxii project"
    version 1.0
    using 
        core.console as console,
        core.context as context,
		core.inspector as inspector
    
action init:
	def ruaha {
        namespace: "test.tanzania"
		name: "ruaha" 
	    semantics: {{ earth:Terrestrial earth:Region }}
	    space: {
		    shape: "EPSG:4326 POLYGON((33.796 -7.086, 35.946 -7.086, 35.946 -9.41, 33.796 -9.41, 33.796 -7.086))"
		    grid: 1.km
	    }
	    time: {
		    year: 2014
		    step: 1.day
	    }
    }

@test(name="Substantial identity preservation", 
	description="Check that substantial identity is preserved upon resubmission and redefinitions are disallowed")
action check_substantial_identity:
    ctx <- context.new 
    mainobs <- ctx.submit(ruaha)
	assert [mainobs != null]
		:success "The main observation was created correctly"
		:fail "The main observation was not created"
	mid <- mainobs.id
	resubmitted <- ctx.submit(ruaha)
	assert [resubmitted != null]
		:success "The second submission of the same definition returned an observation"
		:fail "The second submission of the same definition failed"
	rid <- resubmitted.id
	assert [mid == rid]
		:fail "A resubmitted substantial observation was re-created instead of returned"
		:success "The resubmitted observation URN is correctly used to key existing observations"

@test(name="Direct quality observation", 
	description="Test successive submission of a raw subject and a quality in its context")
action resolve_quality:

    ctx <- context.new 
    mainobs <- ctx.submit(ruaha)
	elevation <- 
		ctx.submit({{geography:Elevation in m}} 
            :within mainobs 
            :namespace "staging.vxii.basic"
            :project "klab.staging.vxii")
	assert 
		inspector.viable(elevation !nodata) 
			:success "Generated elevation data are complete and correct"
			:fail    "No-data values appear in the observation, indicating resolution or computation problems"

@test(name="Implicit quality resolution", 
	description="Test raw subject submission in a namespace that explains by observing two additional qualities")
action ns_resolution:

    ctx <- context.new
    mainobs <- ctx.submit(ruaha
		:namespace "staging.vxii.basic"
        :project "klab.staging.vxii")

